# ============================================================================
# DIANO ADMIN DASHBOARD — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secrets or production credentials to version control.
# NEVER expose BACKEND_API_URL or internal secrets via NEXT_PUBLIC_* variables.

# Runtime Environment (development | test | production)
NODE_ENV=development

# Public Frontend Origin (Admin Portal URL)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-Only Upstream Backend Origin (Used by Next.js Server Components & BFF Route Handlers)
BACKEND_API_URL=http://localhost:5000

# Browser-Safe API Base URL (Points to same-origin BFF proxy or approved public API gateway)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

#Browser-Safe WebSocket Origin for Socket.IO Real-Time Bus
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

